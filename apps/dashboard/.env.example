# Trusted server-side Signal API origin. Never expose provider credentials here.
SIGNAL_API_BASE_URL=http://127.0.0.1:8000

# Exact browser origin used for same-origin POST validation. HTTPS is mandatory
# outside loopback development.
SIGNAL_DASHBOARD_ORIGIN=http://localhost:3000

# Exact HTTPS origin of the configured identity provider. Loopback HTTP is accepted
# only by a nonproduction dashboard for the disposable local pilot. This is a
# redirect allowlist, not a client secret. Leave unset until the API identity
# gateway is also configured.
# SIGNAL_IDENTITY_PROVIDER_ORIGIN=https://identity.example.test
