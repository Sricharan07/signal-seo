{
  admin off
  auto_https off
  https_port 8443
  servers {
    protocols h1 h2
  }
  log default {
    output discard
  }
}

__ORIGIN__ {
  tls /run/signal-ingress/public.pem /run/signal-ingress/public-key.pem
  request_body {
    max_size 64KB
  }
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Strict-Transport-Security "max-age=86400"
  }
  @credential_url path /identity/* /auth/callback /auth/*/callback
  header @credential_url {
    Referrer-Policy no-referrer
    defer
  }
  @dashboard_url not path /identity/* /auth/callback /auth/*/callback
  header @dashboard_url {
    Referrer-Policy same-origin
    defer
  }
  @identity path /identity/resources/* /identity/realms/signal/protocol/openid-connect/auth /identity/realms/signal/protocol/openid-connect/logout /identity/realms/signal/login-actions/* /identity/realms/signal/.well-known/openid-configuration /identity/realms/signal/protocol/openid-connect/certs
  handle @identity {
    reverse_proxy https://identity:8443 {
      transport http {
        tls_trust_pool file /run/signal-ingress/ca.pem
        dial_timeout 5s
        response_header_timeout 35s
      }
    }
  }
  __PROVIDER_CALLBACKS__
  @private path /identity* /admin* /metrics* /health* /api* /v1* /openapi.json /docs /auth/*/callback /webhooks*
  handle @private {
    respond 404
  }
  handle {
    reverse_proxy https://dashboard:8443 {
      transport http {
        tls_trust_pool file /run/signal-ingress/ca.pem
        dial_timeout 5s
        response_header_timeout 15s
      }
    }
  }
  handle_errors {
    header Cache-Control no-store
    respond "Signal unavailable" {err.status_code}
  }
}
