FROM python:3.12.14-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/apps/api/src:/app/services/control_plane/src
WORKDIR /app
COPY requirements.txt /app/
RUN pip install --no-cache-dir -r requirements.txt
COPY apps/api/src /app/apps/api/src
COPY services/control_plane/src /app/services/control_plane/src
COPY database /app/database
COPY scripts/self_host_jobs.py /app/self_host_jobs.py
USER 10001:10001
CMD ["uvicorn", "signal_api.self_host_runtime:create_self_host_app", "--factory", "--host", "0.0.0.0", "--port", "8443", "--ssl-keyfile", "/run/signal-self-host/tls/server-key.pem", "--ssl-certfile", "/run/signal-self-host/tls/server.pem", "--no-access-log", "--no-proxy-headers", "--log-level", "critical"]
