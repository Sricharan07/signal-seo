FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c AS build
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
COPY package.json package-lock.json /app/
COPY apps/dashboard/package.json /app/apps/dashboard/
RUN npm ci --ignore-scripts
COPY apps/dashboard /app/apps/dashboard
RUN npm run build:dashboard
FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 NODE_EXTRA_CA_CERTS=/run/signal-tls/ca.pem
WORKDIR /app/apps/dashboard
COPY --from=build /app /app
COPY deploy/integration-test/application/dashboard-server.mjs /app/apps/dashboard/server.mjs
COPY deploy/integration-test/application/dashboard-server-options.mjs /app/apps/dashboard/dashboard-server-options.mjs
USER 1000:1000
CMD ["node", "server.mjs"]
